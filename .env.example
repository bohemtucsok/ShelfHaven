# === MySQL ===
MYSQL_ROOT_PASSWORD=change_me_root_password
MYSQL_PASSWORD=change_me_user_password

# === NextAuth ===
NEXTAUTH_SECRET=change-me-generate-with-openssl-rand-base64-32
NEXTAUTH_URL=http://localhost:3000
AUTH_TRUST_HOST=true

# === File storage (optional) ===
# Host directory for e-books and covers, bind-mounted into the app container.
# Default: ./storage next to docker-compose.yml. Must be writable by uid 1001.
# STORAGE_HOST_PATH=./storage

# === App port (optional) ===
APP_PORT=3000

# === SMTP (optional — admin panelen is allithato) ===
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_SECURE=false
# SMTP_USER=your-email@gmail.com
# SMTP_PASS=your-app-password
# SMTP_FROM="ShelfHaven <noreply@yourdomain.com>"
