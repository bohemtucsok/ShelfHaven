# === MySQL ===
MYSQL_ROOT_PASSWORD=change_me_root_password
MYSQL_PASSWORD=change_me_user_password

# === NextAuth ===
NEXTAUTH_SECRET=change-me-generate-with-openssl-rand-base64-32
NEXTAUTH_URL=http://localhost:3000
AUTH_TRUST_HOST=true

# === File storage (optional) ===
# Host directory for e-books and covers, bind-mounted into the app container.
# Default: ./storage next to docker-compose.yml. Must be writable by uid 1001.
# STORAGE_HOST_PATH=./storage

# === App port (optional) ===
APP_PORT=3000

# === SMTP (optional — admin panelen is allithato) ===
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_SECURE=false
# SMTP_USER=your-email@gmail.com
# SMTP_PASS=your-app-password
# SMTP_FROM="ShelfHaven <noreply@yourdomain.com>"

# === Backup restore zip limits (optional) ===
# Raise these if a larger library's backup is rejected ("Invalid backup: ... (RESTORE_ZIP_...)").
# RESTORE_ZIP_MAX_FILES=20000
# RESTORE_ZIP_MAX_TOTAL_MB=4096
# RESTORE_ZIP_MAX_RATIO=100
# RESTORE_ZIP_MAX_DATABASE_MB=64
# RESTORE_ZIP_MAX_FILE_MB=256
# Size of the uploaded backup ZIP itself (request body), NOT its contents:
# RESTORE_ZIP_MAX_TOTAL_MB above limits the decompressed contents. The upload is
# held in memory (~4x its size while parsing), so raise this together with the
# app container's memory limit (512M by default).
# RESTORE_UPLOAD_MAX_MB=100
